local BasePos = Vector3.new(229.3, 4.0, 466.9)
local Egg2Pos = Vector3.new(245.6, 4.7, -9829.6)
local Egg1Pos = Vector3.new(219.1, 4.7, -16783.8)
local SafeY = 146.5 -- UPDATE BARU DARI SCREENSHOT
local isFlying = false
local autoProgression = false

-- ==========================================
-- FUNGSI CEK RADIUS BASE
-- ==========================================
local function IsAtBase()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        -- Cek apakah karakter berada dalam radius 150 stud dari titik Base
        local distance = (hrp.Position - BasePos).Magnitude
        return distance < 150 
    end
    return false
end

-- ==========================================
-- FUNGSI TERBANG ANTI LASER 
-- ==========================================
local function FlyToDestination(targetPos, destName, currentSpeed)
    if isFlying then 
        StatusTxt.Text = "Status: Sabar bos, lagi terbang! ✈️"
        return 
    end
    
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    isFlying = true
    StatusTxt.Text = string.format("Menuju: %s\nKecepatan: %d SPs", destName, currentSpeed)
    
    hrp.Anchored = true
    
    local startPos = hrp.Position
    local ascendPos = Vector3.new(startPos.X, SafeY, startPos.Z)
    local dist1 = (ascendPos - startPos).Magnitude
    if dist1 > 2 then
        local tween1 = TweenService:Create(hrp, TweenInfo.new(dist1/currentSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(ascendPos)})
        tween1:Play(); tween1.Completed:Wait()
    end
    
    local cruisePos = Vector3.new(targetPos.X, SafeY, targetPos.Z)
    local dist2 = (cruisePos - hrp.Position).Magnitude
    if dist2 > 2 then
        local tween2 = TweenService:Create(hrp, TweenInfo.new(dist2/currentSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(cruisePos)})
        tween2:Play(); tween2.Completed:Wait()
    end
    
    local dist3 = (targetPos - hrp.Position).Magnitude
    if dist3 > 2 then
        local tween3 = TweenService:Create(hrp, TweenInfo.new(dist3/currentSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
        tween3:Play(); tween3.Completed:Wait()
    end
    
    hrp.Anchored = false
    isFlying = false
    StatusTxt.Text = "Status: Berhasil Mendarat! ✅\nSiap Berangkat Lagi."
end

