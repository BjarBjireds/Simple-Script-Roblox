local function getMyPlot()
    local myPlot = nil; local shortestDist = math.huge
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:match("Karenderya") then
            local dp = obj:FindFirstChild("DiningPlot1")
            if dp then
                local refPart = nil
                for _, tableObj in pairs(dp:GetChildren()) do
                    if tableObj.Name:match("Table") then
                        refPart = tableObj:FindFirstChild("PromptPart") or tableObj:FindFirstChild("ChairSpawn1") or tableObj:FindFirstChildWhichIsA("BasePart", true)
                        if refPart then break end
                    end
                end
                if refPart then
                    local dist = (hrp.Position - refPart.Position).Magnitude
                    if dist < shortestDist then shortestDist = dist; myPlot = obj end
                end
            end
        end
    end
    return myPlot
end

local function processOrders()
    local myPlot = getMyPlot()
    if not myPlot then return end
    local success, counterData = pcall(function() return GetCounterInfo:InvokeServer() end)
    if success and type(counterData) == "table" and counterData.NpcId then
        local availableTables = {}
        for _, plot in pairs(myPlot:GetChildren()) do
            if plot.Name:match("DiningPlot") then
                for _, tObj in pairs(plot:GetChildren()) do
                    if tObj.Name:match("Table") then table.insert(availableTables, tObj) end
                end
            end
        end
        if #availableTables > 0 then
            local randomTable = availableTables[math.random(1, #availableTables)]
            AssignNPC:FireServer({["Seat"] = math.random(1, 2), ["NpcId"] = counterData.NpcId, ["NPCName"] = counterData.NpcId, ["Slot"] = randomTable})
            FarmStatusTxt.Text = "Status: Pelanggan ke " .. randomTable.Name
        end
    end
end

local function deliverFood()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
            local act = obj:IsA("ProximityPrompt") and obj.ActionText:lower() or ""
            local objTxt = obj:IsA("ProximityPrompt") and obj.ObjectText:lower() or ""
            local parName = obj.Parent and obj.Parent.Name:lower() or ""
            local objName = obj.Name:lower()
            
            local isFood = act:match("serve") or objTxt:match("serve") or parName:match("plate") or parName:match("cooked") or parName:match("lugaw") or parName:match("pancit") or parName:match("silog") or parName:match("food")
            local isBad = act:match("customize") or act:match("open") or act:match("order") or act:match("take") or act:match("wash") or objName:match("wash") or parName:match("sink") or parName:match("chiller") or parName:match("fridge") or parName:match("counter")

            if isFood and not isBad then
                local tPart = obj.Parent
                if tPart and tPart:IsA("BasePart") and (tPart.Position - hrp.Position).Magnitude <= 45 then 
                    pcall(function()
                        if obj:IsA("ProximityPrompt") then
                            obj.RequiresLineOfSight = false; obj.MaxActivationDistance = 45; fireproximityprompt(obj)
                        else fireclickdetector(obj) end
                    end)
                end
            end
        end
    end
end

local function washPlates()
    local myPlot = getMyPlot()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myPlot or not hrp then return end

    local washPrompt = nil
    local sinkFolder = myPlot:FindFirstChild("Sink")
    if sinkFolder then washPrompt = sinkFolder:FindFirstChild("Wash", true) end
    
    if washPrompt and washPrompt.Enabled then
        local tPart = washPrompt.Parent
        if tPart and tPart:IsA("BasePart") and (tPart.Position - hrp.Position).Magnitude <= 35 then 
            FarmStatusTxt.Text = "Status: Nyikat Piring! 🧼"
            pcall(function()
                PropEquipEvent:FireServer("Sponge", true)
                task.wait(0.2)
                washPrompt.RequiresLineOfSight = false; washPrompt.MaxActivationDistance = 35
                local holdTime = washPrompt.HoldDuration > 0 and washPrompt.HoldDuration or 1
                for i = 1, 6 do
                    if not washPrompt.Enabled then break end
                    washPrompt:InputHoldBegin()
                    fireproximityprompt(washPrompt)
                    task.wait(holdTime + 0.1)
                    washPrompt:InputHoldEnd()
                    task.wait(0.2)
                end
            end)
            pcall(function() PropEquipEvent:FireServer("Sponge", false) end)
        end
    end
end

