local BounceOverlay = Instance.new("ScreenGui")
BounceOverlay.Name = "BounceLinesOverlay"
BounceOverlay.Parent = parent

local BoundsBox = Instance.new("Frame", BounceOverlay)
BoundsBox.Name = "CalibrationBounds"
BoundsBox.BackgroundTransparency = 1
BoundsBox.BorderSizePixel = 2
BoundsBox.BorderColor3 = Color3.fromRGB(255, 0, 0)
BoundsBox.Visible = false

local function DrawLine2D(p1, p2, color)
    local line = Instance.new("Frame")
    line.BackgroundColor3 = color
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    
    local center = (p1 + p2) / 2
    local length = (p2 - p1).Magnitude
    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
    
    line.Position = UDim2.new(0, center.X, 0, center.Y)
    line.Size = UDim2.new(0, length, 0, 2)
    line.Rotation = angle
    line.Parent = BounceOverlay
end

-- ==========================================
-- LOGIKA GEOMETRI
-- ==========================================
local bounceActive = false
local showWallsActive = false
local allowedLines = {["CueLine"] = true, ["ObjectLine"] = true}

local function ProcessGeometryBouncing()
    for _, child in pairs(BounceOverlay:GetChildren()) do
        if child.Name ~= "CalibrationBounds" then child:Destroy() end
    end
    
    BoundsBox.Visible = showWallsActive
    if not bounceActive and not showWallsActive then return end

    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    
    local aimOverlay = pg:FindFirstChild("AimOverlay", true)
    local poolTable = pg:FindFirstChild("PoolTable", true)
    
    if aimOverlay and poolTable then
        local padX = poolTable.AbsoluteSize.X * padXVal
        local padY = poolTable.AbsoluteSize.Y * padYVal
        local minX = poolTable.AbsolutePosition.X + padX
        local minY = poolTable.AbsolutePosition.Y + padY
        local maxX = poolTable.AbsolutePosition.X + poolTable.AbsoluteSize.X - padX
        local maxY = poolTable.AbsolutePosition.Y + poolTable.AbsoluteSize.Y - padY
        
        BoundsBox.Position = UDim2.new(0, minX, 0, minY)
        BoundsBox.Size = UDim2.new(0, maxX - minX, 0, maxY - minY)
        
        if not bounceActive then return end

        local function GetHit(Px, Py, Dx, Dy)
            local bestT = math.huge
            local nX, nY = 0, 0
            
            if Dx < -0.001 then
                local t = (minX - Px) / Dx
                if t > 0.1 and t < bestT then bestT = t; nX, nY = 1, 0 end
            elseif Dx > 0.001 then
                local t = (maxX - Px) / Dx
                if t > 0.1 and t < bestT then bestT = t; nX, nY = -1, 0 end
            end
            
            if Dy < -0.001 then
                local t = (minY - Py) / Dy
                if t > 0.1 and t < bestT then bestT = t; nX, nY = 0, 1 end
            elseif Dy > 0.001 then
                local t = (maxY - Py) / Dy
                if t > 0.1 and t < bestT then bestT = t; nX, nY = 0, -1 end
            end
            
            if bestT == math.huge then return 1000, 0, 0 end
            return bestT, nX, nY
        end
        
        for _, line in pairs(aimOverlay:GetChildren()) do
            if allowedLines[line.Name] and line:IsA("GuiObject") then
                local color = line:IsA("ImageLabel") and line.ImageColor3 or line.BackgroundColor3
                
                local isX = (line.Size.X.Offset + line.Size.X.Scale * 1000) >= (line.Size.Y.Offset + line.Size.Y.Scale * 1000)
                local rot = math.rad(line.AbsoluteRotation)
                local Dx, Dy
                
                if isX then
                    Dx, Dy = math.cos(rot), math.sin(rot)
                else
                    Dx, Dy = math.cos(rot + math.pi/2), math.sin(rot + math.pi/2)
                end
                
                -- PENERAPAN OFFSET PRESISI (SEKARANG BISA DESIMAL 0.1)
                local Px = line.AbsolutePosition.X + (line.AbsoluteSize.X / 2) + offsetXVal
                local Py = line.AbsolutePosition.Y + (line.AbsoluteSize.Y / 2) + offsetYVal
                
                local dist1, nX1, nY1 = GetHit(Px, Py, Dx, Dy)
                local hit1X = Px + Dx * dist1
                local hit1Y = Py + Dy * dist1
                DrawLine2D(Vector2.new(Px, Py), Vector2.new(hit1X, hit1Y), color)
                
                if dist1 < 1000 then
                    local dot = Dx * nX1 + Dy * nY1
                    local Rx = Dx - 2 * dot * nX1
                    local Ry = Dy - 2 * dot * nY1
                    
                    local dist2, nX2, nY2 = GetHit(hit1X, hit1Y, Rx, Ry)
                    local hit2X = hit1X + Rx * dist2
                    local hit2Y = hit1Y + Ry * dist2
                    
                    DrawLine2D(Vector2.new(hit1X, hit1Y), Vector2.new(hit2X, hit2Y), color)
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(ProcessGeometryBouncing)
end)

