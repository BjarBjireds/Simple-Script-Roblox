local function CreateAdjuster(parent, yPos, labelText, isEditable)
    local Frame = Instance.new("Frame", parent)
    Frame.Size = UDim2.new(1, -10, 0, 30)
    Frame.Position = UDim2.new(0, 5, 0, yPos)
    Frame.BackgroundTransparency = 1
    
    local Lbl = Instance.new("TextLabel", Frame)
    Lbl.Size = UDim2.new(0.5, 0, 1, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = labelText
    Lbl.TextColor3 = Color3.new(1,1,1)
    Lbl.Font = Enum.Font.SourceSansBold
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local BtnMin = Instance.new("TextButton", Frame)
    BtnMin.Size = UDim2.new(0, 25, 0, 25)
    BtnMin.Position = UDim2.new(0.6, -15, 0, 2)
    BtnMin.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    BtnMin.Text = "-"
    BtnMin.TextColor3 = Color3.new(1,1,1)
    
    local ValUI
    if isEditable then
        -- Jika editable, gunakan TextBox agar bisa diketik
        ValUI = Instance.new("TextBox", Frame)
        ValUI.ClearTextOnFocus = false
    else
        -- Jika bukan, gunakan TextLabel biasa
        ValUI = Instance.new("TextLabel", Frame)
    end
    
    ValUI.Size = UDim2.new(0, 45, 0, 25)
    ValUI.Position = UDim2.new(0.6, 15, 0, 2)
    ValUI.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    ValUI.TextColor3 = Color3.new(1,1,1)
    if isEditable then
        ValUI.PlaceholderText = "..."
    end
    
    local BtnPlus = Instance.new("TextButton", Frame)
    BtnPlus.Size = UDim2.new(0, 25, 0, 25)
    BtnPlus.Position = UDim2.new(0.6, 65, 0, 2)
    BtnPlus.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    BtnPlus.Text = "+"
    BtnPlus.TextColor3 = Color3.new(1,1,1)
    
    return BtnMin, BtnPlus, ValUI
end

-- Variabel Default (Mengikuti data screenshot terakhirmu)
local padXVal = 0.085 
local padYVal = 0.140 
local offsetXVal = 0 
local offsetYVal = 1 

local xMin, xPlus, xBox = CreateAdjuster(MainFrame, 110, "Tembok Kiri/Kanan", true)
local yMin, yPlus, yBox = CreateAdjuster(MainFrame, 145, "Tembok Atas/Bawah", true)
local offXMin, offXPlus, offXLbl = CreateAdjuster(MainFrame, 180, "🎯 Offset Garis X", false)
local offYMin, offYPlus, offYLbl = CreateAdjuster(MainFrame, 215, "🎯 Offset Garis Y", false)

local function UpdateLabels()
    xBox.Text = string.format("%.1f", padXVal * 100)
    yBox.Text = string.format("%.1f", padYVal * 100)
    offXLbl.Text = string.format("%.1f", offsetXVal)
    offYLbl.Text = string.format("%.1f", offsetYVal)
end

-- Inisialisasi awal
UpdateLabels()

-- Logika Tembok (Step 0.1% = 0.001)
xMin.MouseButton1Click:Connect(function() padXVal = math.max(0, padXVal - 0.001); UpdateLabels() end)
xPlus.MouseButton1Click:Connect(function() padXVal = math.min(0.4, padXVal + 0.001); UpdateLabels() end)
yMin.MouseButton1Click:Connect(function() padYVal = math.max(0, padYVal - 0.001); UpdateLabels() end)
yPlus.MouseButton1Click:Connect(function() padYVal = math.min(0.4, padYVal + 0.001); UpdateLabels() end)

-- Fitur Custom Input untuk Tembok
xBox.FocusLost:Connect(function()
    local val = tonumber(xBox.Text)
    if val then padXVal = math.clamp(val / 100, 0, 0.4) end
    UpdateLabels()
end)
yBox.FocusLost:Connect(function()
    local val = tonumber(yBox.Text)
    if val then padYVal = math.clamp(val / 100, 0, 0.4) end
    UpdateLabels()
end)

-- Logika Offset (Step 0.1)
offXMin.MouseButton1Click:Connect(function() offsetXVal = offsetXVal - 0.1; UpdateLabels() end)
offXPlus.MouseButton1Click:Connect(function() offsetXVal = offsetXVal + 0.1; UpdateLabels() end)
offYMin.MouseButton1Click:Connect(function() offsetYVal = offsetYVal - 0.1; UpdateLabels() end)
offYPlus.MouseButton1Click:Connect(function() offsetYVal = offsetYVal + 0.1; UpdateLabels() end)


