-- ==========================================
-- LOGIKA INJEKSI PARASIT (HANYA 2 GARIS!)
-- ==========================================
local longLinesActive = false

-- AimLine dihapus dari daftar agar tidak tembus lurus
local allowedLines = {
    ["CueLine"] = true,    -- Pantulan Bola Putih
    ["ObjectLine"] = true  -- Arah Bola Target
}

local function InjectLaser(line)
    if not line:IsA("GuiObject") then return end
    
    local laser = line:FindFirstChild("HackerLaser")
    if not laser then
        laser = Instance.new("Frame")
        laser.Name = "HackerLaser"
        laser.BorderSizePixel = 0
        laser.Parent = line
    end
    
    if longLinesActive then
        laser.Visible = true
        
        if line:IsA("ImageLabel") then
            laser.BackgroundColor3 = line.ImageColor3
        else
            laser.BackgroundColor3 = line.BackgroundColor3
        end
        
        local isX = (line.Size.X.Offset + (line.Size.X.Scale * 1000)) >= (line.Size.Y.Offset + (line.Size.Y.Scale * 1000))
        
        if isX then
            laser.Size = UDim2.new(0, 3000, 1, 0)
            laser.Position = UDim2.new(0.5, 0, 0.5, 0)
            laser.AnchorPoint = Vector2.new(0, 0.5)
        else
            laser.Size = UDim2.new(1, 0, 0, 3000)
            laser.Position = UDim2.new(0.5, 0, 0.5, 0)
            laser.AnchorPoint = Vector2.new(0.5, 0)
        end
    else
        laser.Visible = false
    end
end

local function ScanAndInject()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    
    local aimOverlay = pg:FindFirstChild("AimOverlay", true)
    
    if aimOverlay then
        aimOverlay.ClipsDescendants = false
        if aimOverlay.Parent then aimOverlay.Parent.ClipsDescendants = false end
        
        for _, child in pairs(aimOverlay:GetChildren()) do
            -- Hanya menyuntik garis yang ada di allowedLines
            if allowedLines[child.Name] then
                InjectLaser(child)
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    ScanAndInject()
end)

