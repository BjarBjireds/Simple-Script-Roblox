-- ==========================================
-- 3. GLOBAL SMART SCANNER
-- ==========================================
local function GetCurrentPrompt()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end

    -- Menyapu BERSIH seluruh PlayerGui, tidak peduli apa nama foldernya
    for _, desc in ipairs(pg:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" then
            -- Ambil teks dan bersihkan spasi di awal/akhir
            local rawTxt = desc.Text
            local cleanTxt = rawTxt:gsub("^%s*(.-)%s*$", "%1")
            
            -- Hanya cek teks yang cukup panjang (mengabaikan teks UI sampah seperti "12s")
            if #cleanTxt >= 7 and cleanTxt ~= "Tap here to type" and cleanTxt ~= "Menunggu Pertanyaan..." then
                local lowerTxt = string.lower(cleanTxt)
                
                -- 1. Pengecekan Exact Match (Akurat) - Case Insensitive
                for key, _ in pairs(Dictionary) do
                    if string.lower(key) == lowerTxt then
                        return key
                    end
                end
                
                -- 2. Pengecekan Partial Match (Saat teks sedang diketik)
                for key, _ in pairs(Dictionary) do
                    if string.find(string.lower(key), lowerTxt, 1, true) then
                        return key
                    end
                end
            end
        end
    end
    return nil
end

local lastPrompt = ""

RunService.RenderStepped:Connect(function()
    -- Jangan jalankan jika kamus belum termuat
    local dictCount = 0
    for _ in pairs(Dictionary) do dictCount = dictCount + 1 end
    if dictCount == 0 then return end
    
    local currentPrompt = GetCurrentPrompt()
    
    if currentPrompt and currentPrompt ~= lastPrompt then
        lastPrompt = currentPrompt
        PromptText.Text = "Q: " .. currentPrompt
        PromptText.TextColor3 = THEME.Accent
        
        local answers = Dictionary[currentPrompt]
        if answers then
            for i = 1, 3 do
                if answers[i] then
                    AnswerButtons[i].Text = answers[i]
                    AnswerButtons[i].Visible = true
                else
                    AnswerButtons[i].Visible = false
                end
            end
        end
    elseif not currentPrompt and lastPrompt ~= "" then
        lastPrompt = ""
        PromptText.Text = "Menunggu Pertanyaan..."
        PromptText.TextColor3 = THEME.SubText
        for i = 1, 3 do
            AnswerButtons[i].Visible = false
        end
    end
end)
