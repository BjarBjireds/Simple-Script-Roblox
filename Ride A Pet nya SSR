local function clearAll()
    for _, gui in pairs(espCache) do if gui then gui:Destroy() end end
    for _, btn in pairs(buttonCache) do if btn then btn:Destroy() end end
    table.clear(espCache)
    table.clear(buttonCache)
end

local function updateESP()
    if not radarEnabled then return end
    
    freezeTimer()
    
    local activeEggs = {}
    local eggCounts = {}
    local validTargets = {}

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Parent and obj.Parent.Name == "RenderedEggs" then
            local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
            if targetPart then
                table.insert(validTargets, {obj = obj, part = targetPart})
                eggCounts[obj.Name] = (eggCounts[obj.Name] or 0) + 1
            end
        end
    end

    for _, data in ipairs(validTargets) do
        local obj = data.obj
        local targetPart = data.part
        activeEggs[obj] = true
        
        if not espCache[obj] then
            local bg = Instance.new("BillboardGui")
            bg.Size = UDim2.new(0, 120, 0, 30); bg.AlwaysOnTop = true; bg.Adornee = targetPart
            
            local txt = Instance.new("TextLabel", bg)
            txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.Text = obj.Name
            txt.TextStrokeTransparency = 0; txt.TextScaled = true; txt.Font = Enum.Font.SourceSansBold
            
            local lowerName = obj.Name:lower()
            if lowerName:match("mythic") then txt.TextColor3 = Color3.fromRGB(255, 0, 255)
            elseif lowerName:match("flaming") or lowerName:match("divine") then txt.TextColor3 = Color3.fromRGB(255, 69, 0)
            elseif lowerName:match("golden") then txt.TextColor3 = Color3.fromRGB(255, 215, 0)
            else txt.TextColor3 = Color3.fromRGB(0, 255, 255) end
            
            bg.Parent = game.CoreGui
            espCache[obj] = bg
        end

        if not buttonCache[obj] then
            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(1, 0, 0, 25)
            tpBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            tpBtn.Text = "Run: " .. obj.Name
            tpBtn.Font = Enum.Font.SourceSansBold; tpBtn.TextSize = 12
            
            local lowerName = obj.Name:lower()
            if lowerName:match("mythic") then tpBtn.TextColor3 = Color3.fromRGB(255, 100, 255)
            elseif lowerName:match("flaming") or lowerName:match("divine") then tpBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            elseif lowerName:match("golden") then tpBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
            else tpBtn.TextColor3 = Color3.new(1, 1, 1) end
            
            tpBtn.MouseButton1Click:Connect(function()
                runTo(targetPart.CFrame)
            end)
            
            tpBtn.Parent = EggList
            buttonCache[obj] = tpBtn
        end

        if buttonCache[obj] then
            buttonCache[obj].LayoutOrder = eggCounts[obj.Name]
        end
    end

    for obj, _ in pairs(espCache) do
        if not activeEggs[obj] or not obj.Parent or obj.Parent.Name ~= "RenderedEggs" then
            if espCache[obj] then espCache[obj]:Destroy(); espCache[obj] = nil end
            if buttonCache[obj] then buttonCache[obj]:Destroy(); buttonCache[obj] = nil end
        end
    end
end

RadarBtn.MouseButton1Click:Connect(function()
    radarEnabled = not radarEnabled
    if radarEnabled then
        RadarBtn.Text = "Radar & Auto-Run: ON"
        RadarBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
    else
        RadarBtn.Text = "Radar & Auto-Run: OFF"
        RadarBtn.BackgroundColor3 = Color3.fromRGB(60, 50, 50)
        clearAll()
        if currentTween then currentTween:Cancel() end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if radarEnabled then updateESP() end
    end
end)
