-- FUNGSI CARI WARUNG (FIXED: Balik pakai versi V3 yang terbukti manjur)
local function getMyPlot()
    local myPlot = nil
    local shortestDist = math.huge
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:match("Karenderya") then
            local diningPlot = obj:FindFirstChild("DiningPlot1")
            if diningPlot then
                local refPart = nil
                for _, tableObj in pairs(diningPlot:GetChildren()) do
                    if tableObj.Name:match("Table") then
                        refPart = tableObj:FindFirstChild("PromptPart") or tableObj:FindFirstChild("ChairSpawn1") or tableObj:FindFirstChildWhichIsA("BasePart", true)
                        if refPart then break end
                    end
                end
                
                if refPart then
                    local dist = (hrp.Position - refPart.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        myPlot = obj
                    end
                end
            end
        end
    end
    return myPlot
end

-- LOGIKA 1: AUTO ASSIGN ORDER (Remote Based)
local function processOrders()
    local myPlot = getMyPlot()
    if not myPlot then return end
    
    local success, counterData = pcall(function() return GetCounterInfo:InvokeServer() end)
    if success and type(counterData) == "table" and counterData.NpcId then
        local availableTables = {}
        for _, plot in pairs(myPlot:GetChildren()) do
            if plot.Name:match("DiningPlot") then
                for _, tableObj in pairs(plot:GetChildren()) do
                    if tableObj.Name:match("Table") then table.insert(availableTables, tableObj) end
                end
            end
        end
        if #availableTables > 0 then
            local randomTable = availableTables[math.random(1, #availableTables)]
            AssignNPC:FireServer({
                ["Seat"] = math.random(1, 2),
                ["NpcId"] = counterData.NpcId,
                ["NPCName"] = counterData.NpcId,
                ["Slot"] = randomTable
            })
            StatusTxt.Text = "Status: Pelanggan ke " .. randomTable.Name
        end
    end
end

-- LOGIKA 2: INFINITE RADIUS OMNI-VACUUM
local function deliverFood()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local act = obj.ActionText:lower()
            local objTxt = obj.ObjectText:lower()
            local parName = obj.Parent and obj.Parent.Name:lower() or ""
            
            -- Filter Makanan
            local isFood = act:match("serve") or objTxt:match("serve") or 
                           parName:match("plate") or parName:match("cooked") or parName:match("lugaw") or 
                           parName:match("pancit") or parName:match("silog") or parName:match("food")
            
            -- Blacklist ketat (Gak boleh mencet kasir atau kulkas)
            local isBad = act:match("customize") or act:match("open") or act:match("order") or act:match("take") or
                          parName:match("chiller") or parName:match("fridge") or parName:match("counter")

            if isFood and not isBad then
                pcall(function()
                    -- INJEKSI RADIUS TANPA BATAS (Bypass Roblox Distance Check)
                    obj.RequiresLineOfSight = false
                    obj.MaxActivationDistance = 1000 
                    
                    fireproximityprompt(obj)
                end)
            end
        end
    end
end

