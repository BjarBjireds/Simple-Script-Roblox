local function StartFly()
    local char = LP.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    bg = Instance.new("BodyGyro", hrp)
    bg.P = 9e4; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bg.CFrame = hrp.CFrame
    
    bv = Instance.new("BodyVelocity", hrp)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9); bv.Velocity = Vector3.new(0, 0, 0)
    
    char.Humanoid.PlatformStand = true
    FlyControlUI.Visible = true 
end

local function StopFly()
    if bg then bg:Destroy() end
    if bv then bv:Destroy() end
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then
        LP.Character.Humanoid.PlatformStand = false
    end
    FlyControlUI.Visible = false 
end

FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    if isFlying then
        FlyBtn.Text = "🦅 FLY: ON"; FlyBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        StartFly()
    else
        FlyBtn.Text = "🦅 FLY: OFF"; FlyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StopFly()
    end
end)

RunService.RenderStepped:Connect(function()
    if isFlying and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local cam = Workspace.CurrentCamera
        local hum = LP.Character:FindFirstChild("Humanoid")
        local moveDir = Vector3.new(0, 0, 0)
        
        if hum and hum.MoveDirection.Magnitude > 0 then
            moveDir = hum.MoveDirection
        end
        
        if holdingUp then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if holdingDown then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
        
        flySpeed = tonumber(FlySpeedBox.Text) or 50
        
        if bg and bv then
            bv.Velocity = moveDir * flySpeed
            bg.CFrame = cam.CFrame
        end
    end
end)
