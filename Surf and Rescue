-- ==========================================
-- LOGIKA AUTO FARM (TARGET LOCK SYSTEM)
-- ==========================================
local autoGrab = false
local autoClean = false
local isCurrentlyCleaning = false

task.spawn(function()
    while task.wait(0.01) do 
        if autoGrab then pcall(function() GrabTap:FireServer() end) end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if autoClean then
            pcall(function()
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local closestDirtDist = 35 -- Radius awal aman
                    local targetAnimal = nil
                    
                    -- FASE 1: TARGET LOCK (Cari hewan milik kita yang paling dekat)
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and tonumber(obj.Name) and not obj:IsDescendantOf(LP.Character) and obj.Transparency < 1 then
                            local dist = (hrp.Position - obj.Position).Magnitude
                            if dist < closestDirtDist then
                                closestDirtDist = dist
                                targetAnimal = obj.Parent -- Mengunci model hewannya
                            end
                        end
                    end
                    
                    -- FASE 2: AMBIL SEMUA KOTORAN (Hanya dari hewan yang dikunci)
                    local validDirtIDs = {}
                    if targetAnimal then
                        for _, obj in pairs(targetAnimal:GetChildren()) do
                            if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and tonumber(obj.Name) and obj.Transparency < 1 then
                                table.insert(validDirtIDs, tonumber(obj.Name))
                            end
                        end
                    end
                    
                    -- FASE 3: EKSEKUSI PEMBERSIHAN
                    if #validDirtIDs > 0 then
                        CleanRemove:FireServer(validDirtIDs)
                        isCurrentlyCleaning = true
                    else
                        if isCurrentlyCleaning then
                            task.wait(0.2)
                            CleanLeave:FireServer()
                            isCurrentlyCleaning = false
                        end
                    end
                end
            end)
        end
    end
end)

