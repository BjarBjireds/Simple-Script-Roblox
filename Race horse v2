-- ==========================================
-- FUNGSI BANTUAN UMUM
-- ==========================================
local function checkItem(itemName)
    local char = LP.Character
    local backpack = LP:FindFirstChild("Backpack")
    if not char or not backpack then return false, nil end
    for _, item in pairs(char:GetChildren()) do
        if item.Name:lower():match(itemName:lower()) then return true, item end
    end
    for _, item in pairs(backpack:GetChildren()) do
        if item.Name:lower():match(itemName:lower()) then return true, item end
    end
    return false, nil
end

local function isTreeEmpty(tree)
    if not tree then return true end
    for _, desc in pairs(tree:GetDescendants()) do
        if desc:IsA("TextLabel") and (desc.Text:match("0/") or desc.Text:match("0 /")) then return true end
    end
    return false
end

local function getReadyTree()
    local treesFolder = Workspace:FindFirstChild("Trees")
    if not treesFolder then return nil, nil end
    for _, tree in pairs(treesFolder:GetChildren()) do
        if not isTreeEmpty(tree) then
            local treePart = tree:FindFirstChildWhichIsA("BasePart", true)
            if treePart then return tree, treePart end
        end
    end
    return nil, nil
end

local function getNearestHorse(pos)
    local targetHorse = nil
    local nearestDist = 100 
    local horsesFolder = Workspace:FindFirstChild("Horses")
    if horsesFolder then
        for _, horse in pairs(horsesFolder:GetChildren()) do
            local horsePos = (horse.PrimaryPart and horse.PrimaryPart.Position) or (horse:FindFirstChildWhichIsA("BasePart", true) and horse:FindFirstChildWhichIsA("BasePart", true).Position)
            if horsePos then
                local dist = (pos - horsePos).Magnitude
                if dist < nearestDist then nearestDist = dist; targetHorse = horse end
            end
        end
    end
    return targetHorse
end

local function getMyPrivatePoop()
    if not titikKandang then return nil, nil end
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:match("Poop") then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if part and (part.Position - titikKandang).Magnitude <= 60 then return obj, part end
        end
    end
    return nil, nil
end

local function getNearestBin(pos)
    local targetBin = nil
    local nearestDist = math.huge
    local stablesFolder = Workspace:FindFirstChild("Stables")
    if stablesFolder then
        for _, obj in pairs(stablesFolder:GetDescendants()) do
            if obj.Name:match("Bin") or obj.Name:match("Trash") then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local dist = (pos - part.Position).Magnitude
                    if dist < nearestDist then nearestDist = dist; targetBin = obj end
                end
            end
        end
    end
    return targetBin
end

-- FUNGSI BARU: RADAR MUDBODY AKURAT 100%
local function getDirtyHorseWithMud(pos)
    local targetHorse = nil
    local nearestDist = 60 -- Jarak aman kandang sendiri
    local horsesFolder = Workspace:FindFirstChild("Horses")
    
    if horsesFolder then
        for _, horse in pairs(horsesFolder:GetChildren()) do
            local isDirty = false
            -- Cari objek persis bernama "MudBody" dari hasil scan kamu
            for _, desc in pairs(horse:GetDescendants()) do
                if desc.Name == "MudBody" then
                    isDirty = true
                    break
                end
            end
            
            if isDirty then
                local horsePos = (horse.PrimaryPart and horse.PrimaryPart.Position) or (horse:FindFirstChildWhichIsA("BasePart", true) and horse:FindFirstChildWhichIsA("BasePart", true).Position)
                if horsePos then
                    local dist = (pos - horsePos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        targetHorse = horse
                    end
                end
            end
        end
    end
    return targetHorse
end

