task.spawn(function()
    while task.wait(0.5) do 
        if autoCollect then
            -- Failsafe: Kalau AutoFeed mati, jangan stuck di feeding phase
            if not autoFeed then isFeedingPhase = false end
            
            -- Kalau tas penuh dan AutoFeed nyala, KUNCI mode panen!
            if isBagFull() and autoFeed and titikKandang then
                isFeedingPhase = true
            end
            
            -- Hanya panen kalau LAGI NGGAK FASE MAKAN
            if not isFeedingPhase then
                local tree, treePart = getReadyTree()
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if tree and hrp then
                    hrp.CFrame = treePart.CFrame * CFrame.new(0, 0, 4) 
                    task.wait(0.2) 
                    pcall(function() FireRemote:FireServer("Interact", tree) end)
                    StatusTxt.Text = "Status: Panen Apel... 🍎"
                    task.wait(0.3)
                end
            end
        end
    end
end)

-- ==========================================
-- LOGIKA 2: MACHINE GUN FEED (MASTER)
-- ==========================================
task.spawn(function()
    while task.wait(0.5) do 
        if autoFeed and titikKandang then
            -- Tentukan kapan harus ngasih makan
            local shouldFeed = false
            if autoCollect then
                shouldFeed = isFeedingPhase -- Kalau dua2nya nyala, tunggu panen penuh
            else
                shouldFeed = true -- Kalau panen mati, gas makan terus
            end

            if shouldFeed then
                local hasApple, targetApple = checkApples()
                
                -- Kalau apel 0, LEPAS KUNCI biar bisa panen lagi!
                if not hasApple then
                    if autoCollect then isFeedingPhase = false end
                    StatusTxt.Text = "Status: Apel Ludes! ❌🍎"
                    continue
                end

                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and targetApple then
                    hum:EquipTool(targetApple)
                    task.wait(0.1)

                    -- TELEPORT KE KANDANG
                    hrp.CFrame = CFrame.new(titikKandang)
                    task.wait(0.3) 
                    
                    local horse = getNearestHorse(titikKandang)
                    if horse then
                        StatusTxt.Text = "Status: MACHINE GUN FEED! 💥🐴"
                        -- TEMBAK 10 APEL SECEPAT KILAT!
                        while autoFeed do
                            local stillHas = checkApples()
                            if not stillHas then break end -- Stop kalau apel habis
                            
                            pcall(function() FireRemote:FireServer("Interact", horse) end)
                            task.wait(0.05) -- Kecepatan Super V4
                        end
                        -- Setelah tembakan selesai, lepas kunci
                        isFeedingPhase = false 
                    else
                        StatusTxt.Text = "Status: Gak ada kuda! Nyari ulang... 🔍"
                    end
                end
            end
        end
    end
end)
