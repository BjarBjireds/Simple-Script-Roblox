-- Cek apakah ada apel di tas/tangan
local function checkApples()
    local char = LP.Character
    local backpack = LP:FindFirstChild("Backpack")
    if not char or not backpack then return false, nil end
    for _, item in pairs(char:GetChildren()) do
        if item.Name:lower():match("apple") then return true, item end
    end
    for _, item in pairs(backpack:GetChildren()) do
        if item.Name:lower():match("apple") then return true, item end
    end
    return false, nil
end

-- Cek peringatan tas penuh
local function isBagFull()
    for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
        if gui:IsA("TextLabel") and gui.Visible then
            local txt = gui.Text:lower()
            if txt:match("you can only carry") or txt:match("carry 10 apples") or txt:match("10 apples") then
                return true
            end
        end
    end
    return false
end

-- Cari pohon berbuah
local function getReadyTree()
    local treesFolder = Workspace:FindFirstChild("Trees")
    if not treesFolder then return nil, nil end
    for _, tree in pairs(treesFolder:GetChildren()) do
        local isEmpty = false
        for _, desc in pairs(tree:GetDescendants()) do
            if desc:IsA("TextLabel") and (desc.Text:match("0/") or desc.Text:match("0 /")) then
                isEmpty = true; break
            end
        end
        if not isEmpty then
            local treePart = tree:FindFirstChildWhichIsA("BasePart", true)
            if treePart then return tree, treePart end
        end
    end
    return nil, nil
end

-- Radar Kuda Ultra (100 Meter)
local function getNearestHorse(pos)
    local targetHorse = nil
    local nearestDist = 100 -- Jangkauan diperbesar drastis!
    local horsesFolder = Workspace:FindFirstChild("Horses")
    
    if horsesFolder then
        for _, horse in pairs(horsesFolder:GetChildren()) do
            local horsePos = nil
            if horse.PrimaryPart then horsePos = horse.PrimaryPart.Position
            else
                local part = horse:FindFirstChildWhichIsA("BasePart", true)
                if part then horsePos = part.Position end
            end
            
            if horsePos then
                local dist = (pos - horsePos).Magnitude
                if dist < nearestDist then
                    nearestDist = dist; targetHorse = horse
                end
            end
        end
    end
    return targetHorse
end

