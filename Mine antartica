local bodyVelocity, bodyGyro = nil, nil

FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    FlyBtn.Text = flying and "Fly: ON" or "Fly: OFF"
    FlyBtn.BackgroundColor3 = flying and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(50, 60, 80)
    
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if flying then
        bodyVelocity = Instance.new("BodyVelocity", hrp)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Velocity = Vector3.zero
        bodyGyro = Instance.new("BodyGyro", hrp)
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.CFrame = hrp.CFrame
    else
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end
end)

RunService.RenderStepped:Connect(function()
    if flying and bodyVelocity and bodyGyro and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChild("Humanoid") then
        local cam = workspace.CurrentCamera
        local speed = tonumber(SpeedBox.Text) or 50
        local moveDir = LP.Character.Humanoid.MoveDirection
        
        if moveDir.Magnitude > 0 then
            local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
            local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
            local moveForward = moveDir:Dot(flatLook)
            local moveRight = moveDir:Dot(flatRight)
            local flyDir = (cam.CFrame.LookVector * moveForward) + (cam.CFrame.RightVector * moveRight)
            
            bodyVelocity.Velocity = flyDir.Unit * speed
        else
            bodyVelocity.Velocity = Vector3.zero
        end
        bodyGyro.CFrame = cam.CFrame
    end
end)
