local ESPBtn = Instance.new("TextButton", PageESP)
ESPBtn.Size = UDim2.new(1, -20, 0, 35); ESPBtn.Position = UDim2.new(0, 10, 0, 10)
ESPBtn.BackgroundColor3 = Color3.fromRGB(50, 60, 80)
ESPBtn.Text = "Gem ESP: OFF"
ESPBtn.TextColor3 = Color3.new(1, 1, 1); ESPBtn.Font = Enum.Font.SourceSansBold

local espEnabled = false
local espCache = {}

local function clearESP()
    for _, data in pairs(espCache) do 
        if data.bg then data.bg:Destroy() end 
        if data.hl then data.hl:Destroy() end
    end
    table.clear(espCache)
end

local function getRarityColor(rarity)
    local r = tostring(rarity):lower()
    if r == "mythic" or r == "divine" then return Color3.fromRGB(255, 0, 0)
    elseif r == "exotic" then return Color3.fromRGB(255, 0, 255)
    elseif r == "zenith" then return Color3.fromRGB(0, 255, 255)
    else return nil end
end

local function updateESP()
    if not espEnabled then return end
    local spawnedGems = Workspace:FindFirstChild("SpawnedGems")
    if not spawnedGems then return end
    
    local activeGems = {}
    for _, gem in pairs(spawnedGems:GetChildren()) do
        local rarity = gem:GetAttribute("Rarity") or "Common"
        local color = getRarityColor(rarity)
        
        if color then
            activeGems[gem] = true
            if not espCache[gem] then
                local targetPart = gem:IsA("Model") and gem.PrimaryPart or gem:FindFirstChildWhichIsA("BasePart") or (gem:IsA("BasePart") and gem)
                if targetPart then
                    local kg = gem:GetAttribute("Kg") or 0
                    local value = gem:GetAttribute("Value") or 0
                    
                    -- 1. Teks ESP (Nempel pas di tengah)
                    local bg = Instance.new("BillboardGui")
                    bg.Size = UDim2.new(0, 150, 0, 20)
                    bg.AlwaysOnTop = true; bg.Adornee = targetPart
                    bg.ExtentsOffset = Vector3.new(0, 0, 0) -- HAPUS OFFSET BIAR PRESISI
                    bg.MaxDistance = 300 
                    
                    local txt = Instance.new("TextLabel", bg)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = string.format("%s - %skg - $%s", tostring(rarity), tostring(kg), tostring(value))
                    txt.TextColor3 = color; txt.TextStrokeTransparency = 1
                    txt.TextScaled = true; txt.Font = Enum.Font.SourceSansBold
                    bg.Parent = CoreGui
                    
                    -- 2. Highlight Chams (Bentuk 3D Tembus Pandang)
                    local hl = Instance.new("Highlight")
                    hl.Adornee = gem
                    hl.FillColor = color
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0.2
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Tembus Tembok!
                    hl.Parent = CoreGui
                    
                    espCache[gem] = {bg = bg, hl = hl}
                end
            end
        end
    end
    
    for gem, data in pairs(espCache) do
        if not activeGems[gem] or not gem.Parent then
            if data.bg then data.bg:Destroy() end
            if data.hl then data.hl:Destroy() end
            espCache[gem] = nil
        end
    end
end

ESPBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        ESPBtn.Text = "Gem ESP: ON"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    else
        ESPBtn.Text = "Gem ESP: OFF"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(50, 60, 80)
        clearESP()
    end
end)

task.spawn(function()
    while task.wait(1.5) do
        if espEnabled then updateESP() end
    end
end)

