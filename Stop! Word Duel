-- 5. FUNGSI BYPASS HARDWARE KEYBOARD
local vim = game:GetService("VirtualInputManager")

local function TypeVirtualKey(targetChar)
    local keyCode
    if targetChar == "back" then 
        keyCode = Enum.KeyCode.Backspace
    elseif targetChar == "enter" then 
        keyCode = Enum.KeyCode.Return
    else 
        pcall(function() keyCode = Enum.KeyCode[string.upper(targetChar)] end) 
    end
    
    if keyCode then
        pcall(function()
            vim:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.01)
            vim:SendKeyEvent(false, keyCode, false, game)
        end)
    end
end

-- 6. MESIN TYPER KILAT
local function AutoTypeWord(word)
    for i = 1, 15 do  
        TypeVirtualKey("back") 
        task.wait(0.01)
    end
    task.wait(0.1)

    for i = 1, #word do
        local char = string.sub(string.lower(word), i, i)
        TypeVirtualKey(char)
        task.wait(0.02)
    end
    
    task.wait(0.1)
    TypeVirtualKey("enter")
end

-- 7. UPDATE UI & PENCARIAN KATA
local function UpdateResults()
    for _, child in pairs(ResultScroll:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    
    local foundCount = 0
    
    if activeLetter ~= "" and activeCategory ~= "" and WordDB[activeCategory] then
        for _, word in ipairs(WordDB[activeCategory]) do
            if string.sub(string.lower(word), 1, 1) == activeLetter then
                foundCount = foundCount + 1
                
                local ansBtn = Instance.new("TextButton", ResultScroll)
                ansBtn.Size = UDim2.new(1, -10, 0, 27)
                ansBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
                ansBtn.TextColor3 = Color3.fromRGB(0, 255, 100)
                ansBtn.Text = " > " .. string.upper(word)
                ansBtn.Font = Enum.Font.SourceSansBold
                ansBtn.TextSize = 15
                ansBtn.TextXAlignment = Enum.TextXAlignment.Left
                
                ansBtn.Activated:Connect(function()
                    if isAutoTypeOn then
                        ansBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                        AutoTypeWord(word)
                        task.wait(0.1)
                        ansBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
                    else
                        ansBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
                        task.wait(0.2)
                        ansBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
                    end
                end)
            end
        end
    end
    
    if foundCount == 0 then
        local err = Instance.new("TextLabel", ResultScroll)
        err.Size = UDim2.new(1, -10, 0, 25)
        err.BackgroundTransparency = 1
        err.TextColor3 = Color3.fromRGB(200, 50, 50)
        if activeLetter == "" or activeCategory == "" then
            err.Text = "Menunggu Radar..."
        elseif not next(WordDB) then
            err.Text = "Error: DB Cloud Kosong!"
        else
            err.Text = "Kosong / Kata Tidak Ada!"
        end
        err.Font = Enum.Font.SourceSansItalic
        err.TextSize = 14
    end
    ResultScroll.CanvasSize = UDim2.new(0, 0, 0, foundCount * 29)
end

