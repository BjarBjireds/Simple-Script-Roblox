-- ==========================================
-- LOOP 1: VACUUM BLACKHOLE 🌪️
-- ==========================================
task.spawn(function()
    RunService.Heartbeat:Connect(function()
        if isVacuuming and holePosition then
            local itemsFolder = Workspace:FindFirstChild("LocalItems")
            if itemsFolder then
                for _, item in pairs(itemsFolder:GetChildren()) do
                    if item:IsA("BasePart") then
                        item.CFrame = CFrame.new(holePosition)
                        item.CanCollide = false 
                    elseif item:IsA("Model") and item.PrimaryPart then
                        item:SetPrimaryPartCFrame(CFrame.new(holePosition))
                    else
                        local part = item:FindFirstChildWhichIsA("BasePart")
                        if part then
                            part.CFrame = CFrame.new(holePosition)
                            part.CanCollide = false
                        end
                    end
                end
            end
        end
    end)
end)

