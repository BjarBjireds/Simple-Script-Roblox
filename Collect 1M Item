-- ==========================================
-- LOOP 1: VACUUM GRAVITY CRUSH 🌪️ 
-- ==========================================
task.spawn(function()
    RunService.Heartbeat:Connect(function()
        if isVacuuming and holePosition then
            local itemsFolder = Workspace:FindFirstChild("LocalItems")
            if itemsFolder then
                for _, item in pairs(itemsFolder:GetChildren()) do
                    local partToMove = nil
                    
                    if item:IsA("BasePart") then
                        partToMove = item
                    elseif item:IsA("Model") and item.PrimaryPart then
                        partToMove = item.PrimaryPart
                    else
                        partToMove = item:FindFirstChildWhichIsA("BasePart")
                    end
                    
                    if partToMove then
                        local offsetX = math.random(-2, 2)
                        local offsetZ = math.random(-2, 2)
                        local dropPos = holePosition + Vector3.new(offsetX, 0, offsetZ)
                        
                        partToMove.CFrame = CFrame.new(dropPos)
                        partToMove.CanCollide = false 
                        partToMove.AssemblyLinearVelocity = Vector3.new(0, -500, 0) 
                    end
                end
            end
        end
    end)
end)

-- ==========================================
-- LOOP 2: AUTO UPGRADE & SMART TRAILS 📈 
-- ==========================================
task.spawn(function()
    local trailList = {
        "White", "Blue", "Green", "Yellow", "Orange", 
        "Red", "Black", "Rainbow", "Monochrome", "Opalescent"
    }

    while task.wait(1) do 
        if autoUpgrade then
            pcall(function()
                BuyUpgrade:FireServer("CashMultiplier")
                BuyUpgrade:FireServer("SpawnSpeed")
                BuyUpgrade:FireServer("CapacityLimit")
                BuyUpgrade:FireServer("DropAmount")
                
                for _, trailName in ipairs(trailList) do
                    BuyTrail:FireServer(trailName)
                end
            end)
        end
    end
end)

-- ==========================================
-- LOOP 3: PURE REMOTE AUTO REBIRTH & PRESTIGE 🔄
-- ==========================================
task.spawn(function()
    while task.wait(3) do -- Cek tiap 3 detik
        if autoRebirth then
            -- Murni nembak server langsung dari belakang layar, gak butuh klik UI!
            pcall(function()
                BuyRebirth:FireServer()
                FreezeStreak:FireServer(true)
                BuyPrestige:FireServer()
            end)
        end
    end
end)

-- ==========================================
-- LOOP 4: PHANTOM UI CLICKER (CLAIM ALL INDEX DOANG) 🎁
-- ==========================================
task.spawn(function()
    -- Yang ini tetep dipertahanin karena remote "Claim All" nya diacak server
    while task.wait(5) do 
        if autoIndex then
            pcall(function()
                ClaimIndex:FireServer("Tix")
                
                for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
                    if (gui:IsA("TextLabel") or gui:IsA("TextButton")) and gui.Text ~= "" then
                        if gui.Text:lower():match("claim all") then
                            local btn = nil
                            if gui:IsA("GuiButton") then 
                                btn = gui
                            elseif gui.Parent and gui.Parent:IsA("GuiButton") then 
                                btn = gui.Parent
                            elseif gui.Parent and gui.Parent.Parent and gui.Parent.Parent:IsA("GuiButton") then 
                                btn = gui.Parent.Parent 
                            end
                            
                            if btn and getconnections then
                                for _, conn in pairs(getconnections(btn.MouseButton1Click)) do
                                    pcall(function() conn:Fire() end)
                                    pcall(function() conn.Function() end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
