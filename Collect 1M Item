    VacuumBtn.Text = isVacuuming and "2. VACUUM MODE: ON" or "2. VACUUM MODE: OFF"
    VacuumBtn.BackgroundColor3 = isVacuuming and Color3.fromRGB(255, 0, 100) or Color3.fromRGB(40, 20, 50)
    StatusTxt.Text = isVacuuming and "Status: MENYEDOT ITEM... 🌪️" or "Status: Vacuum Idle."
end)

